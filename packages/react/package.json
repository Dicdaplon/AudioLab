{
  "name": "@audiolab/react",
  "version": "0.5.0",
  "description": "React hooks, components, plots and games for @audiolab/core: live key and chord readouts, spectrum and tempo plots, ear-training games, with the Loupe design system.",
  "keywords": [
    "react",
    "audio",
    "web-audio",
    "key-detection",
    "chord-detection",
    "tempo",
    "ear-training",
    "music"
  ],
  "license": "MIT",
  "author": "dicdaplon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dicdaplon/AudioLab.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Dicdaplon/AudioLab/tree/main/packages/react#readme",
  "bugs": "https://github.com/Dicdaplon/AudioLab/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "audiolab-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./art": {
      "audiolab-source": "./src/art.ts",
      "types": "./dist/art.d.ts",
      "default": "./dist/art.js"
    },
    "./styles.css": {
      "audiolab-source": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./fonts.css": {
      "audiolab-source": "./src/styles/fonts.css",
      "default": "./dist/fonts.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.art.config.ts"
  },
  "dependencies": {
    "@audiolab/core": "^0.5.0"
  },
  "peerDependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/source-serif-4": "^5.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@fontsource/ibm-plex-mono": {
      "optional": true
    },
    "@fontsource/ibm-plex-sans": {
      "optional": true
    },
    "@fontsource/source-serif-4": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
