{
  "name": "audiolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based audio analysis lab: live key and chord detection, spectrum and noise-floor analysis, and ear-training games built on the Web Audio API.",
  "license": "MIT",
  "author": "dicdaplon",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicdaplon/AudioLab.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --project unit --project dom",
    "test:samples": "vitest run --project samples",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project dom",
    "typecheck": "tsc -b",
    "sweep": "tsx scripts/parameterSweep.ts",
    "extract:backing": "tsx scripts/extractBackingExtracts.ts",
    "analyze:backing": "tsx scripts/analyzeBacking.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "audio-decode": "^2.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
