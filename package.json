{
  "name": "audiolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser audio-analysis SDK (key, chord and tempo detection on the Web Audio API) with a React component library and a lab app.",
  "license": "MIT",
  "author": "dicdaplon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dicdaplon/AudioLab.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/lab",
    "build": "npm run build:packages && npm run build -w apps/lab",
    "build:packages": "npm run build -w packages/core -w packages/react",
    "check:packages": "publint packages/core && publint packages/react && attw --pack packages/core --profile esm-only && attw --pack packages/react --profile esm-only --exclude-entrypoints ./styles.css ./fonts.css",
    "preview": "npm run preview -w apps/lab",
    "test": "vitest run --project unit --project dom",
    "test:samples": "vitest run --project samples",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project dom",
    "coverage": "vitest run --project unit --project dom --coverage",
    "typecheck": "tsc -b",
    "sweep": "npm run sweep -w packages/core",
    "extract:backing": "npm run extract:backing -w packages/core",
    "analyze:backing": "npm run analyze:backing -w packages/core",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build:packages && npm run check:packages && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "audio-decode": "^2.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
