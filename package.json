{
  "name": "audiolab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-based audio analysis lab: live key and chord detection, spectrum and noise-floor analysis, and ear-training games built on the Web Audio API.",
  "license": "MIT",
  "author": "dicdaplon",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dicdaplon/AudioLab.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "sweep": "tsx scripts/parameterSweep.ts",
    "extract:backing": "tsx scripts/extractBackingExtracts.ts",
    "analyze:backing": "tsx scripts/analyzeBacking.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "audio-decode": "^2.2.2",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
